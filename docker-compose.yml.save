services:

  postgres:
    image: postgres:15
    container_name: postgres
    environment:
      POSTGRES_USER: user
      POSTGRES_PASSWORD: pass
      POSTGRES_DB: attendance
    ports:
      - "5432:5432"       # Must be exposed so host-network containers can reach it via localhost
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U user -d attendance"]
      interval: 5s
      timeout: 5s
      retries: 10

  django-auth:
    build:
      context: .
      dockerfile: Dockerfiles/django.Dockerfile
    container_name: django_auth
    ports:
      - "8000:8000"
    environment:
      - DATABASE_URL=postgresql+asyncpg://user:pass@postgres:5432/attendance
      - DJANGO_SECRET_KEY=supersecretkey
    volumes:
      - ./django_auth:/app
    depends_on:
      postgres:
        condition: service_healthy
    command: python manage.py runserver 0.0.0.0:8000

  django-hr:
    build:
      context: .
      dockerfile: Dockerfiles/django_hr.Dockerfile
    container_name: django_hr
    ports:
      - "8002:8002"
    environment:
      - DATABASE_URL=postgresql://user:pass@postgres:5432/hr_db
      - DJANGO_SECRET_KEY=hr-supersecretkey-changeme
      - JWT_SECRET_KEY=supersecretkey
      - DEBUG=True
      - ALLOWED_HOSTS=localhost,127.0.0.1,192.168.8.210
      - CORS_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.8.210:3000
    volumes:
      - ./django_hr:/app
      - django_hr_media:/app/media
    depends_on:
      postgres:
        condition: service_healthy
      django-auth:
        condition: service_started
    command: >
        sh -c "python manage.py migrate &&
             gunicorn config.wsgi:application
             --bind 0.0.0.0:8002
             --workers 8
             --threads 2
             --worker-class gthread
             --timeout 120
             --max-requests 1000
             --max-requests-jitter 50"
    restart: unless-stopped

  fastapi:
    build:
      context: .
      dockerfile: Dockerfiles/fastapi.Dockerfile
    container_name: fastapi
    network_mode: "host"
    environment:
      - DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/attendance
      - DJANGO_AUTH_URL=http://127.0.0.1:8000/api/clockers/
      - DJANGO_HR_URL=http://127.0.0.1:8002
      - DJANGO_SECRET_KEY=supersecretkey
    volumes:
      - ./:/app
    depends_on:
      postgres:
        condition: service_healthy
      django-auth:
        condition: service_started
    restart: unless-stopped

  sync:
    build:
      context: .
      dockerfile: Dockerfiles/fastapi.Dockerfile
    container_name: attendance_sync
    network_mode: "host"
    command: python sync_service.py
    environment:
      - DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/attendance
      - DJANGO_AUTH_URL=http://127.0.0.1:8000/api/clockers/
      - DJANGO_HR_URL=http://127.0.0.1:8002
    volumes:
      - ./:/app
    depends_on:
      postgres:
        condition: service_healthy
      django-auth:
        condition: service_started
    restart: unless-stopped

  react:
    build:
      context: ./frontend
      dockerfile: ../Dockerfiles/react.Dockerfile
    container_name: react
    ports:
      - "3000:3000"
    environment:
      - REACT_APP_API_URL=http://192.168.8.210:8080
      - REACT_APP_AUTH_URL=http://192.168.8.210:8000
      - REACT_APP_HR_URL=http://192.168.8.210:8002
    volumes:
      - ./frontend:/app
    depends_on:
      - fastapi
      - django-hr

volumes:
  postgres_data:
  django_hr_media:
