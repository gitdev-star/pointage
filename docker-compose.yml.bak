services:

  postgres:
    image: postgres:15
    container_name: postgres
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"]
      interval: 5s
      timeout: 5s
      retries: 10

  redis:
    image: redis:7-alpine
    container_name: redis_pointage
    ports:
      - "6380:6379"
    restart: unless-stopped

  django-auth:
    build:
      context: .
      dockerfile: Dockerfiles/django.Dockerfile
    container_name: django_auth
    ports:
      - "8000:8000"
    env_file: .env
    environment:
      - POSTGRES_DB=${POSTGRES_DB}
      - POSTGRES_USER=${POSTGRES_USER}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_HOST=${POSTGRES_HOST}
      - POSTGRES_PORT=${POSTGRES_PORT}
      - DJANGO_SECRET_KEY=${DJANGO_SECRET_KEY}
      - JWT_SECRET_KEY=${JWT_SECRET_KEY}
      - LDAP_SERVER_URI=ldap://192.168.8.1:389
    volumes:
      - ./django_auth:/app
    depends_on:
      redis:
        condition: service_started
    command: sh -c "python manage.py migrate && python manage.py collectstatic --noinput && gunicorn config.wsgi:application --bind 0.0.0.0:8000 --workers 8 --threads 2 --worker-class gthread --timeout 120 --max-requests 1000 --max-requests-jitter 50"

  django-hr:
    build:
      context: .
      dockerfile: Dockerfiles/django_hr.Dockerfile
    container_name: django_hr
    ports:
      - "8002:8002"
    env_file: .env
    environment:
      - DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${HR_DB_NAME}
      - ATTENDANCE_DB_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
      - DJANGO_SECRET_KEY=${DJANGO_SECRET_KEY}
      - JWT_SECRET_KEY=${JWT_SECRET_KEY}
      - DEBUG=${DEBUG}
      - ALLOWED_HOSTS=${ALLOWED_HOSTS}
      - CORS_ALLOWED_ORIGINS=${CORS_ALLOWED_ORIGINS}
      - EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
      - EMAIL_HOST=${EMAIL_HOST}
      - EMAIL_PORT=${EMAIL_PORT}
      - EMAIL_USE_SSL=${EMAIL_USE_SSL}
      - EMAIL_USE_TLS=${EMAIL_USE_TLS}
      - EMAIL_HOST_USER=${EMAIL_HOST_USER}
      - EMAIL_HOST_PASSWORD=${EMAIL_HOST_PASSWORD}
      - DEFAULT_FROM_EMAIL=${DEFAULT_FROM_EMAIL}
      - PYTHONUNBUFFERED=1
    volumes:
      - ./django_hr:/app
      - django_hr_media:/app/media
    depends_on:
      django-auth:
        condition: service_started
      redis:
        condition: service_started
    command: sh -c "/app/entrypoint.sh"
    restart: unless-stopped

  fastapi:
    build:
      context: .
      dockerfile: Dockerfiles/fastapi.Dockerfile
    container_name: fastapi
    network_mode: "host"
    env_file: .env
    environment:
      - DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
      - DJANGO_AUTH_URL=http://127.0.0.1:8000/api/clockers/
      - DJANGO_HR_URL=http://127.0.0.1:8002
      - DJANGO_SECRET_KEY=${DJANGO_SECRET_KEY}
      - HR_DB_HOST=${POSTGRES_HOST}
      - HR_DB_PORT=${POSTGRES_PORT}
      - HR_DB_NAME=${HR_DB_NAME}
      - HR_DB_USER=${POSTGRES_USER}
      - HR_DB_PASSWORD=${POSTGRES_PASSWORD}
    volumes:
      - ./:/app
    depends_on:
      django-auth:
        condition: service_started
    restart: unless-stopped

  sync:
    build:
      context: .
      dockerfile: Dockerfiles/fastapi.Dockerfile
    container_name: attendance_sync
    network_mode: "host"
    command: python sync_service.py
    env_file: .env
    environment:
      - DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
      - DJANGO_AUTH_URL=http://127.0.0.1:8000/api/clockers/
      - DJANGO_HR_URL=http://127.0.0.1:8002
    volumes:
      - ./:/app
    depends_on:
      django-auth:
        condition: service_started
    restart: unless-stopped

  react:
    build:
      context: ./frontend
      dockerfile: ../Dockerfiles/react.Dockerfile
    container_name: react
    ports:
      - "3000:3000"
    environment:
      - REACT_APP_API_URL=http://192.168.8.210:8080
      - REACT_APP_AUTH_URL=http://192.168.8.210:8000
      - REACT_APP_HR_URL=http://192.168.8.210:8002
      - CHOKIDAR_USEPOLLING=true
      - FAST_REFRESH=false
      - WDS_SOCKET_PORT=3000
    volumes:
      - ./frontend:/app
    depends_on:
      - fastapi
      - django-hr

  cron:
    build:
      context: .
      dockerfile: Dockerfiles/django_hr.Dockerfile
    container_name: pointage_cron
    restart: unless-stopped
    env_file: .env
    depends_on:
      - redis
    environment:
      - DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${HR_DB_NAME}
      - ATTENDANCE_DB_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
      - DJANGO_SECRET_KEY=${DJANGO_SECRET_KEY}
      - JWT_SECRET_KEY=${JWT_SECRET_KEY}
      - DEBUG=${DEBUG}
      - ALLOWED_HOSTS=${ALLOWED_HOSTS}
      - EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
      - EMAIL_HOST=${EMAIL_HOST}
      - EMAIL_PORT=${EMAIL_PORT}
      - EMAIL_USE_SSL=${EMAIL_USE_SSL}
      - EMAIL_USE_TLS=${EMAIL_USE_TLS}
      - EMAIL_HOST_USER=${EMAIL_HOST_USER}
      - EMAIL_HOST_PASSWORD=${EMAIL_HOST_PASSWORD}
      - DEFAULT_FROM_EMAIL=${DEFAULT_FROM_EMAIL}
    volumes:
      - ./django_hr:/app
    command: bash -c "echo '0 7 * * * cd /app && python3 manage.py send_cdd_alerts >> /var/log/cron.log 2>&1' > /etc/cron.d/hr-cron && echo '0 7 * * * cd /app && python3 manage.py send_maternity_alerts >> /var/log/cron.log 2>&1' >> /etc/cron.d/hr-cron && chmod 0644 /etc/cron.d/hr-cron && crontab /etc/cron.d/hr-cron && cron -f"

volumes:
  postgres_data:
  django_hr_media:
